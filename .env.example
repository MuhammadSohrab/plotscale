VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_APP_URL=http://localhost:5173
VITE_UNIT_CATALOG_URL=https://catalog.plotscale.app/v1/catalog.json
# Ed25519 raw public key, Base64 encoded. Never place a private signing key in the app.
VITE_UNIT_PACK_PUBLIC_KEY=replace-with-public-key
VITE_UNIT_PACK_KEY_ID=primary
# Browser-visible Google Maps key. Restrict it by HTTP referrer, API and quota.
VITE_GOOGLE_MAPS_API_KEY=
# Use a production Google Maps map ID when available.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
